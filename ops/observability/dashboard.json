    "panels": {
      "3f9d18bf-4a2c-4aff-93e0-951602e97af4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Estimated 95th percentile of API response times in milliseconds, calculated from the recorded histogram. Synthetic local demonstration.",
            "name": "API response time p95 (ms)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": null
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "ms"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "aggregations": [
                            {
                              "metricName": "aeris.http.duration.bucket",
                              "spaceAggregation": "p95",
                              "temporality": "",
                              "timeAggregation": "rate"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "legend": "",
                          "name": "A",
                          "signal": "metrics",
                          "source": ""
                        },
                        "type": "builder_query"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "b4cf82da-4209-45e3-aa7c-eca5fd33aa17": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Completed API requests in the isolated local Aeris demo. Health probes and static assets are excluded.",
            "name": "API requests per second"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": null
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "{request}"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "aggregations": [
                            {
                              "metricName": "aeris.http.requests",
                              "spaceAggregation": "sum",
                              "temporality": "",
                              "timeAggregation": "rate"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "legend": "",
                          "name": "A",
